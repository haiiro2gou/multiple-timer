{
  "name": "multiple-timer",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist/",
    "tsc": "tsc",
    "build": "npm-run-all clean tsc && vite build",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src/**/*.tsx",
    "eslint:fix": "eslint --fix src/**/*.{ts,tsx}",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "npm-run-all --parallel eslint check-types",
    "lint:fix": "npm-run-all --parallel eslint:fix check-types format",
    "prepare": "husky"
  },
  "author": "haiiro2gou <mrashen.2gou@gmail.com>",
  "license": "MIT License",
  "homepage": "https://haiiro2gou.github.io/multiple-timer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haiiro2gou/multiple-timer.git"
  },
  "bugs": {
    "url": "https://github.com/haiiro2gou/multiple-timer/issues"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.89.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@haiiro2gou/eslint-config": "^1.4.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --cache --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
